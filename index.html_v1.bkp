<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#6C63FF">
<title>Alphabet Flipper</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background:
    radial-gradient(circle at top left, #fff1a8 0%, transparent 35%),
    radial-gradient(circle at bottom right, #d9c8ff 0%, transparent 40%),
    linear-gradient(135deg, #e9f8ff, #fff5fc);
  color: #172033;
}

button {
  font-family: inherit;
  cursor: pointer;
}

.app {
  width: 100%;
  max-width: 520px;
  min-height: 100vh;
  margin: auto;
  padding: 18px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 22px;
  font-weight: 900;
}

.subtitle {
  font-size: 12px;
  color: #667085;
  margin-top: 4px;
}

.settings-btn {
  width: 48px;
  height: 48px;
  border: 0;
  border-radius: 16px;
  background: white;
  font-size: 22px;
  box-shadow: 0 8px 25px rgba(0,0,0,.08);
}

.home {
  text-align: center;
  padding-top: 55px;
}

.hero {
  font-size: 76px;
  animation: float 2s ease-in-out infinite;
}

@keyframes float {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

h1 {
  font-size: 34px;
  margin: 12px 0 8px;
}

.home p {
  color: #667085;
  font-size: 15px;
  line-height: 1.5;
}

.primary {
  width: 100%;
  border: 0;
  border-radius: 20px;
  padding: 17px;
  margin-top: 18px;
  color: white;
  font-size: 18px;
  font-weight: 900;
  background: linear-gradient(135deg, #6c63ff, #9b5cff, #ff5ca8);
  box-shadow: 0 12px 30px rgba(108,99,255,.35);
}

.learn {
  display: none;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
}

.progress {
  height: 9px;
  background: rgba(255,255,255,.7);
  border-radius: 20px;
  overflow: hidden;
  margin: 18px 0;
}

.progress-bar {
  height: 100%;
  width: 0%;
  border-radius: 20px;
  background: linear-gradient(90deg,#ff8a00,#ff4f81,#6c63ff);
  transition: width .4s ease;
}

.card-area {
  perspective: 1200px;
  margin-top: 20px;
}

.card {
  width: 100%;
  height: 360px;
  position: relative;
  transform-style: preserve-3d;
  transition: transform .65s cubic-bezier(.2,.8,.2,1);
  cursor: pointer;
}

.card.flipped {
  transform: rotateY(180deg);
}

.face {
  position: absolute;
  inset: 0;
  border-radius: 32px;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.front {
  color: white;
  background:
    radial-gradient(circle at 20% 20%, rgba(255,255,255,.35), transparent 25%),
    linear-gradient(135deg,#6c63ff,#45c8ff,#ff6ca8);
  box-shadow: 0 22px 45px rgba(75,70,160,.3);
}

.front-content {
  padding: 30px;
}

.flip-icon {
  font-size: 58px;
  margin-bottom: 12px;
}

.tap {
  font-size: 27px;
  font-weight: 900;
}

.hint {
  margin-top: 8px;
  font-size: 14px;
  opacity: .9;
}

.back {
  transform: rotateY(180deg);
  background: white;
  box-shadow: 0 22px 45px rgba(0,0,0,.13);
}

.content {
  width: 100%;
  padding: 20px;
}

.letter {
  font-size: 105px;
  line-height: .9;
  font-weight: 900;
  color: #6c63ff;
}

.case {
  display: inline-block;
  padding: 7px 13px;
  border-radius: 50px;
  background: #eeeaff;
  color: #654cff;
  font-size: 12px;
  font-weight: 900;
  margin-top: 8px;
}

.picture {
  font-size: 62px;
  margin-top: 12px;
}

.word {
  font-size: 30px;
  font-weight: 900;
  margin-top: 4px;
}

.phonics {
  font-size: 20px;
  color: #654cff;
  font-weight: 900;
  margin-top: 5px;
}

.example {
  color: #667085;
  font-size: 13px;
  margin-top: 5px;
}

.actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.action {
  flex: 1;
  border: 0;
  border-radius: 18px;
  padding: 15px;
  font-size: 15px;
  font-weight: 900;
}

.again {
  background: white;
}

.sound {
  background: #172033;
  color: white;
}

.message {
  margin-top: 14px;
  padding: 13px;
  text-align: center;
  border-radius: 17px;
  background: rgba(255,255,255,.7);
  color: #475467;
  font-size: 13px;
  font-weight: 700;
}

.settings {
  display: none;
  margin-top: 18px;
  background: white;
  padding: 18px;
  border-radius: 22px;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-title {
  font-weight: 900;
}

.setting-desc {
  font-size: 12px;
  color: #667085;
  margin-top: 4px;
}

.toggle {
  border: 0;
  padding: 7px;
  border-radius: 50px;
  background: #ddd;
}

.toggle span {
  display: block;
  background: white;
  border-radius: 50px;
  padding: 8px 13px;
  font-weight: 900;
}

.toggle.on {
  background: #6c63ff;
}

.back-home {
  border: 0;
  background: white;
  padding: 10px 14px;
  border-radius: 14px;
  font-weight: 800;
}

@media (max-width: 400px) {
  .app { padding: 13px; }
  .card { height: 320px; }
  .letter { font-size: 90px; }
  .picture { font-size: 52px; }
  .word { font-size: 26px; }
}
</style>
</head>

<body>

<div class="app">

  <div class="header">
    <div>
      <div class="logo">🔤 Alphabet Flipper</div>
      <div class="subtitle">Learn • Flip • Discover</div>
    </div>
    <button class="settings-btn" onclick="toggleSettings()">⚙️</button>
  </div>

  <div id="settings" class="settings">
    <div class="setting-row">
      <div>
        <div class="setting-title">🔁 Repeat Alphabets</div>
        <div class="setting-desc">Allow an alphabet to appear again</div>
      </div>
      <button id="repeatToggle" class="toggle" onclick="toggleRepeat()">
        <span>OFF</span>
      </button>
    </div>
  </div>

  <section id="home" class="home">
    <div class="hero">🔤✨</div>
    <h1>Let's Learn ABC!</h1>
    <p>
      Flip the card, discover an alphabet,
      see a picture and learn its sound.
    </p>
    <button class="primary" onclick="startLearning()">🚀 Start Learning</button>
  </section>

  <section id="learn" class="learn">
    <div class="topbar">
      <button class="back-home" onclick="goHome()">← Home</button>
      <strong id="counter">0 / 52</strong>
    </div>

    <div class="progress">
      <div id="progressBar" class="progress-bar"></div>
    </div>

    <div class="card-area">
      <div id="card" class="card" onclick="flipCard()">
        <div class="face front">
          <div class="front-content">
            <div class="flip-icon">🔄</div>
            <div class="tap">Tap to Flip!</div>
            <div class="hint">A surprise alphabet is waiting ✨</div>
          </div>
        </div>

        <div class="face back">
          <div class="content">
            <div id="letter" class="letter">A</div>
            <div id="case" class="case">Capital Letter</div>
            <div id="picture" class="picture">🍎</div>
            <div id="word" class="word">Apple</div>
            <div id="phonics" class="phonics">/æ/</div>
            <div id="example" class="example">A is for Apple</div>
          </div>
        </div>
      </div>
    </div>

    <div class="actions">
      <button class="action again" onclick="flipBack(event)">🔄 Flip Again</button>
      <button class="action sound" onclick="playSound(event)">🔊 Sound</button>
    </div>

    <div id="message" class="message">
      🎯 Tap the card to reveal the alphabet.
    </div>
  </section>

</div>

<script>
const alphabet = [
  ["A","a","🍎","Apple","/æ/"],
  ["B","b","⚽","Ball","/b/"],
  ["C","c","🐱","Cat","/k/"],
  ["D","d","🐶","Dog","/d/"],
  ["E","e","🐘","Elephant","/e/"],
  ["F","f","🐟","Fish","/f/"],
  ["G","g","🐐","Goat","/g/"],
  ["H","h","🎩","Hat","/h/"],
  ["I","i","🍦","Ice Cream","/ɪ/"],
  ["J","j","🧃","Juice","/dʒ/"],
  ["K","k","🪁","Kite","/k/"],
  ["L","l","🦁","Lion","/l/"],
  ["M","m","🥭","Mango","/m/"],
  ["N","n","🪺","Nest","/n/"],
  ["O","o","🍊","Orange","/ɒ/"],
  ["P","p","🦜","Parrot","/p/"],
  ["Q","q","👑","Queen","/kw/"],
  ["R","r","🐰","Rabbit","/r/"],
  ["S","s","☀️","Sun","/s/"],
  ["T","t","🐯","Tiger","/t/"],
  ["U","u","☂️","Umbrella","/ʌ/"],
  ["V","v","🚐","Van","/v/"],
  ["W","w","🍉","Watermelon","/w/"],
  ["X","x","🎼","Xylophone","/z/"],
  ["Y","y","🦬","Yak","/j/"],
  ["Z","z","🦓","Zebra","/z/"]
];

const TOTAL_CARDS = alphabet.length * 2;

let repeat = false;
let used = [];
let currentCard = -1;
let totalShown = 0;
let started = false;
let busy = false;
let needNewOnFlip = false;

function toggleSettings() {
  const box = document.getElementById("settings");
  box.style.display = box.style.display === "block" ? "none" : "block";
}

function toggleRepeat() {
  repeat = !repeat;
  const btn = document.getElementById("repeatToggle");
  btn.classList.toggle("on", repeat);
  btn.querySelector("span").textContent = repeat ? "ON" : "OFF";

  if (!repeat) {
    used = [];
    document.getElementById("message").textContent =
      "🎯 Repeat OFF — all 52 cards appear once per cycle.";
  } else {
    document.getElementById("message").textContent =
      "🔁 Repeat ON — alphabets can appear again.";
  }
  updateProgress();
}

function startLearning() {
  started = true;
  document.getElementById("home").style.display = "none";
  document.getElementById("learn").style.display = "block";
  used = [];
  totalShown = 0;
  needNewOnFlip = false;
  pickNewAlphabet();
}

function goHome() {
  document.getElementById("learn").style.display = "none";
  document.getElementById("home").style.display = "block";
  document.getElementById("card").classList.remove("flipped");
}

function pickNewAlphabet() {
  let pool;

  if (repeat) {
    pool = Array.from({ length: TOTAL_CARDS }, (_, i) => i);
  } else {
    pool = Array.from({ length: TOTAL_CARDS }, (_, i) => i)
      .filter(i => !used.includes(i));
  }

  if (pool.length === 0) {
    used = [];
    pool = Array.from({ length: TOTAL_CARDS }, (_, i) => i);
  }

  let next = pool[Math.floor(Math.random() * pool.length)];

  if (pool.length > 1 && next === currentCard) {
    const pos = pool.indexOf(next);
    next = pool[(pos + 1) % pool.length];
  }

  currentCard = next;
  totalShown++;
  if (!repeat) {
    used.push(currentCard);
  }

  updateCard();
}

function updateCard() {
  const letterIndex = Math.floor(currentCard / 2);
  const isSmall = currentCard % 2 === 1;
  const item = alphabet[letterIndex];
  const shownLetter = isSmall ? item[1] : item[0];

  document.getElementById("letter").textContent = shownLetter;
  document.getElementById("case").textContent =
    isSmall ? "Small Letter" : "Capital Letter";
  document.getElementById("picture").textContent = item[2];
  document.getElementById("word").textContent = item[3];
  document.getElementById("phonics").textContent = item[4];
  document.getElementById("example").textContent = shownLetter + " is for " + item[3];

  updateProgress();
}

function updateProgress() {
  if (repeat) {
    document.getElementById("counter").textContent = "Shown: " + totalShown;
    document.getElementById("progressBar").style.width = "100%";
  } else {
    document.getElementById("counter").textContent = used.length + " / " + TOTAL_CARDS;
    const pct = Math.min((used.length / TOTAL_CARDS) * 100, 100);
    document.getElementById("progressBar").style.width = pct + "%";
  }
}

function flipCard() {
  if (!started || busy) return;

  const card = document.getElementById("card");
  const flipped = card.classList.contains("flipped");

  if (!flipped) {
    if (needNewOnFlip) {
      pickNewAlphabet();
      needNewOnFlip = false;
    }
    card.classList.add("flipped");
    document.getElementById("message").textContent =
      "✨ Great! Tap again for a new random alphabet.";
  } else {
    busy = true;
    card.classList.remove("flipped");

    setTimeout(() => {
      pickNewAlphabet();
      card.classList.add("flipped");
      document.getElementById("message").textContent =
        "🎉 New random alphabet! Keep learning.";
      busy = false;
    }, 350);
  }
}

function flipBack(event) {
  event.stopPropagation();
  needNewOnFlip = true;
  document.getElementById("card").classList.remove("flipped");
  document.getElementById("message").textContent =
    "🔄 Tap the card again to get a new alphabet.";
}

function playSound(event) {
  event.stopPropagation();
  if (currentCard < 0) return;

  const letterIndex = Math.floor(currentCard / 2);
  const item = alphabet[letterIndex];
  const shownLetter = document.getElementById("letter").textContent;
  const text = shownLetter + ", " + item[3];

  if (window.AndroidTTS && typeof window.AndroidTTS.speak === "function") {
    window.AndroidTTS.speak(text);
    return;
  }

  if ("speechSynthesis" in window) {
    speechSynthesis.cancel();
    const speech = new SpeechSynthesisUtterance(text);
    speech.lang = "en-IN";
    speech.rate = 0.8;
    speechSynthesis.speak(speech);
  }
}

if ("serviceWorker" in navigator) {
  window.addEventListener("load", () => {
    navigator.serviceWorker.register("./sw.js").catch(() => {});
  });
}
</script>

</body>
</html>
